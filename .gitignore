# data - never commit (directories re-included only for their .gitkeep)
data/*
!data/raw/
!data/cache/
!data/artifacts/
data/raw/*
data/cache/*
data/artifacts/*
!data/raw/.gitkeep
!data/cache/.gitkeep
!data/artifacts/.gitkeep

# python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# node (only if a React front end is ever added)
node_modules/
dist/
.vite/

# secrets / local
.env
.env.*
*.local
gcs-credentials*.json
.streamlit/secrets.toml

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# frontend/public/data/*.json IS committed: it is the Vercel deployment's data source (cap 8 MB, enforced by tests)
