   "NationalCell": {
    "properties": {
     "lead": {
      "title": "Lead",
      "type": "integer"
     },
     "season": {
      "title": "Season",
      "type": "string"
     },
     "n": {
      "title": "N",
      "type": "integer"
     },
     "bust_rate": {
      "title": "Bust Rate",
      "type": "number"
     },
     "err_p50": {
      "title": "Err P50",
      "type": "number"
     },
     "err_p95": {
      "title": "Err P95",
      "type": "number"
     }
    },
    "required": [
     "lead",
     "season",
     "n",
     "bust_rate",
     "err_p50",
     "err_p95"
    ],
    "title": "NationalCell",
    "type": "object"
   },
   "WorstEvent": {
    "properties": {
