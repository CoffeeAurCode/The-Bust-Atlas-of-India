{
 "meta.json": {
  "$defs": {
   "RegionMeta": {
    "properties": {
     "id": {
      "title": "Id",
      "type": "string"
     },
     "label": {
      "title": "Label",
      "type": "string"
     },
     "box": {
      "description": "[lat0, lat1, lon0, lon1]",
      "items": {
       "type": "number"
      },
      "title": "Box",
      "type": "array"
     },
     "centroid": {
      "description": "[lat, lon]",
      "items": {
       "type": "number"
      },
      "title": "Centroid",
      "type": "array"
     }
    },
    "required": [
     "id",
     "label",
     "box",
     "centroid"
    ],
    "title": "RegionMeta",
    "type": "object"
   },
   "SeasonMeta": {
    "properties": {
     "id": {
      "title": "Id",
      "type": "string"
     },
     "label": {
      "title": "Label",
      "type": "string"
     }
    },
    "required": [
     "id",
     "label"
    ],
    "title": "SeasonMeta",
    "type": "object"
   }
  },
  "properties": {
   "product": {
    "title": "Product",
    "type": "string"
   },
   "source": {
    "title": "Source",
    "type": "string"
   },
   "source_label": {
    "title": "Source Label",
    "type": "string"
   },
   "members": {
    "title": "Members",
    "type": "integer"
   },
   "grid": {
    "title": "Grid",
    "type": "string"
   },
   "variable": {
    "title": "Variable",
    "type": "string"
   },
   "leads": {
    "items": {
     "type": "integer"
    },
    "title": "Leads",
    "type": "array"
   },
   "years": {
    "additionalProperties": {
     "items": {
      "type": "integer"
     },
     "type": "array"
    },
    "title": "Years",
    "type": "object"
   },
   "regions": {
    "items": {
     "$ref": "#/$defs/RegionMeta"
    },
    "title": "Regions",
    "type": "array"
   },
   "state_to_region": {
    "additionalProperties": {
     "type": "string"
    },
    "title": "State To Region",
    "type": "object"
   },
   "seasons": {
    "items": {
     "$ref": "#/$defs/SeasonMeta"
    },
    "title": "Seasons",
    "type": "array"
   },
   "bust_definition": {
    "title": "Bust Definition",
    "type": "string"
   },
   "bands": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "lower prob bound per band",
    "title": "Bands",
    "type": "object"
   },
   "flag_threshold": {
    "title": "Flag Threshold",
    "type": "number"
   },
   "generated_at": {
    "title": "Generated At",
    "type": "string"
   },
   "git_sha": {
    "title": "Git Sha",
    "type": "string"
   },
   "model": {
    "additionalProperties": true,
    "title": "Model",
    "type": "object"
   },
   "rules": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "description": "feature -> [sentence if raises risk, sentence if lowers]",
    "title": "Rules",
    "type": "object"
   },
   "season_words": {
    "additionalProperties": {
     "type": "string"
    },
    "title": "Season Words",
    "type": "object"
   },
   "synthetic": {
    "default": false,
    "title": "Synthetic",
    "type": "boolean"
   }
  },
  "required": [
   "product",
   "source",
   "source_label",
   "members",
   "grid",
   "variable",
   "leads",
   "years",
   "regions",
   "state_to_region",
   "seasons",
   "bust_definition",
   "bands",
   "flag_threshold",
   "generated_at",
   "git_sha",
   "model",
   "rules",
   "season_words"
  ],
  "title": "Meta",
  "type": "object"
 },
 "atlas.json": {
